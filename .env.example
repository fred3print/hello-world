# Application
NODE_ENV=production
PORT=3000
SESSION_SECRET=votre-secret-de-session-tres-securise-a-changer

# Database PostgreSQL (Heroku automatiquement set DATABASE_URL)
DATABASE_URL=postgres://username:password@localhost:5432/yara_db

# Brevo (anciennement Sendinblue)
BREVO_API_KEY=votre-cle-api-brevo
BREVO_FROM_EMAIL=noreply@votredomaine.com
BREVO_FROM_NAME=Yara

# Application Settings
APP_NAME=Yara
APP_URL=https://votre-app.herokuapp.com
ALLOWED_EMAIL_DOMAIN=sprint.fr

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
