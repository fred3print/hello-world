<%- include('../partials/header') %>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card mt-5">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4 gradient-text">
                        <i class="bi bi-box-arrow-in-right"></i> Connexion
                    </h2>

                    <% if (error) { %>
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> <%= error %>
                        </div>
                    <% } %>

                    <% if (success) { %>
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> <%= success %>
                        </div>
                    <% } %>

                    <form method="POST" action="/login">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="email" class="form-control" id="email" name="email"
                                       value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
                                       placeholder="votre.email@sprint.fr" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label">Mot de passe</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input type="password" class="form-control" id="password" name="password" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            <i class="bi bi-box-arrow-in-right"></i> Se connecter
                        </button>

                        <div class="text-center">
                            <p class="mb-0">
                                Pas encore inscrit ? <a href="/register" class="text-decoration-none">S'inscrire</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-3">
                <p class="text-muted">
                    <i class="bi bi-info-circle"></i> Accès réservé aux adresses @sprint.fr
                </p>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
