<%- include('../partials/header') %>

<div class="container">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>
                <i class="bi bi-person-circle"></i> Détails utilisateur
            </h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="/admin/users" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Informations générales</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th width="30%">ID:</th>
                                <td><code><%= userDetails.id %></code></td>
                            </tr>
                            <tr>
                                <th>Email:</th>
                                <td><%= userDetails.email %></td>
                            </tr>
                            <tr>
                                <th>Prénom:</th>
                                <td><%= userDetails.firstName || '-' %></td>
                            </tr>
                            <tr>
                                <th>Nom:</th>
                                <td><%= userDetails.lastName || '-' %></td>
                            </tr>
                            <tr>
                                <th>Rôle:</th>
                                <td>
                                    <span class="badge bg-<%= userDetails.role === 'admin' ? 'danger' : 'primary' %>">
                                        <%= userDetails.role === 'admin' ? 'Administrateur' : 'Utilisateur' %>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th>Statut du compte:</th>
                                <td>
                                    <span class="badge bg-<%= userDetails.isActive ? 'success' : 'danger' %>">
                                        <%= userDetails.isActive ? 'Actif' : 'Inactif' %>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th>Email vérifié:</th>
                                <td>
                                    <% if (userDetails.isEmailVerified) { %>
                                        <i class="bi bi-check-circle text-success"></i> Oui
                                    <% } else { %>
                                        <i class="bi bi-x-circle text-danger"></i> Non
                                    <% } %>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Activité</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-3">
                            <strong>Inscrit le:</strong><br>
                            <%= new Date(userDetails.createdAt).toLocaleDateString('fr-FR', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            }) %>
                        </li>
                        <li class="mb-3">
                            <strong>Dernière modification:</strong><br>
                            <%= new Date(userDetails.updatedAt).toLocaleDateString('fr-FR', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            }) %>
                        </li>
                        <li class="mb-3">
                            <strong>Dernière connexion:</strong><br>
                            <% if (userDetails.lastLogin) { %>
                                <%= new Date(userDetails.lastLogin).toLocaleDateString('fr-FR', {
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit'
                                }) %>
                            <% } else { %>
                                <span class="text-muted">Jamais connecté</span>
                            <% } %>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">Sécurité</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <strong>Tentatives de connexion:</strong>
                            <span class="badge bg-<%= userDetails.loginAttempts > 0 ? 'warning' : 'success' %>">
                                <%= userDetails.loginAttempts %>
                            </span>
                        </li>
                        <li class="mb-2">
                            <strong>Compte verrouillé:</strong>
                            <% if (userDetails.lockUntil && new Date(userDetails.lockUntil) > new Date()) { %>
                                <span class="badge bg-danger">Oui</span>
                                <br>
                                <small class="text-muted">
                                    Jusqu'au <%= new Date(userDetails.lockUntil).toLocaleString('fr-FR') %>
                                </small>
                            <% } else { %>
                                <span class="badge bg-success">Non</span>
                            <% } %>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
